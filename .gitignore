# ============================================================
# MADHU BOOKHUB — .gitignore
# Files listed here are NEVER committed to Git / GitHub
# ============================================================

# ── Environment variables ────────────────────────────────────
# Contains database credentials. NEVER commit this file.
.env

# ── Node.js dependencies ─────────────────────────────────────
# Install these with: npm install
node_modules/

# ── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── OS generated files ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── Build artifacts ──────────────────────────────────────────
dist/
build/
